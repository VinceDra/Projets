---
interface Props { idPrefix: string; withCompany?: boolean }
const { idPrefix, withCompany = true } = Astro.props;
---
<div class="field">
  <label for={`${idPrefix}-name`}>Nom</label>
  <input type="text" id={`${idPrefix}-name`} name="name" autocomplete="name" required maxlength="120" />
</div>
{withCompany && (
  <div class="field">
    <label for={`${idPrefix}-company`}>Entreprise</label>
    <input type="text" id={`${idPrefix}-company`} name="company" autocomplete="organization" required maxlength="160" />
  </div>
)}
<div class="field">
  <label for={`${idPrefix}-email`}>Email professionnel</label>
  <input type="email" id={`${idPrefix}-email`} name="email" autocomplete="email" required maxlength="254" inputmode="email" />
</div>
